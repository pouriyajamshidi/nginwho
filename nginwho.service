[Unit]
Description=nginwho - nginx log parser and analyzer
After=network.target

[Service]
Type=simple
# root is needed to reload nginx and change nftables rules
User=root
ExecStart=/usr/local/bin/nginwho \
    --logPath:/var/log/nginx/access.log \
    --dbPath:/var/log/nginwho.db \
    --interval:30 \
    --processNginxLogs:true \
    --showRealIps:true \
    --blockUntrustedCidrs:true
Restart=on-failure
RestartSec=5

# hardening. nginwho only writes its database, the nginx CIDRs file and the nftables rules file
NoNewPrivileges=yes
PrivateTmp=yes
# read-only so `nginx -t` still works when the nginx config uses files in /home
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/etc/nginx

[Install]
WantedBy=multi-user.target
