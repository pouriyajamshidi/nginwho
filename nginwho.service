[Unit]
Description=nginwho - saves nginx logs, shows real IPs behind a CDN, guards the firewall, traps bots and serves static sites
After=network.target

[Service]
Type=simple
# root is needed to reload nginx and change nftables rules
User=root
# everything is read from /etc/nginwho/nginwho.conf. add flags here to override it
ExecStart=/usr/local/bin/nginwho
Restart=on-failure
RestartSec=5

# systemd creates /var/lib/nginwho for the database and /var/log/nginwho for the --serve log
StateDirectory=nginwho
# 0755 lets tools like Grafana Alloy list the folder to see the database size
StateDirectoryMode=0755
LogsDirectory=nginwho

# hardening. nginwho only writes its database, the nginx CIDRs file and the nftables rules file
NoNewPrivileges=yes
PrivateTmp=yes
# read-only so `nginx -t` still works when the nginx config uses files in /home
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/etc/nginx

# more hardening. these also apply to the nft, nginx and ss commands nginwho runs
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK is how nft and ss talk to the kernel
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
