// Grafana Alloy config for a server running nginwho. See README.md next to it.
//
// The Grafana Cloud addresses and token come from the environment, so this file
// holds no secrets. On Debian and Ubuntu, put them in /etc/default/alloy

// Exporters

loki.write "default" {
	endpoint {
		url = sys.env("GCLOUD_HOSTED_LOGS_URL")

		basic_auth {
			username = sys.env("GCLOUD_HOSTED_LOGS_ID")
			password = sys.env("GCLOUD_RW_API_KEY")
		}
	}
}

prometheus.remote_write "default" {
	endpoint {
		url = sys.env("GCLOUD_HOSTED_METRICS_URL")

		basic_auth {
			username = sys.env("GCLOUD_HOSTED_METRICS_ID")
			password = sys.env("GCLOUD_RW_API_KEY")
		}
	}
}

//

// NGINX

discovery.relabel "metrics_integrations_integrations_nginx" {
	targets = [{
		__address__  = "localhost:9113",
	}]

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}
}

prometheus.scrape "metrics_integrations_integrations_nginx" {
	targets    = discovery.relabel.metrics_integrations_integrations_nginx.output
	forward_to = [prometheus.remote_write.default.receiver]
	job_name   = "integrations/nginx"
}

//

// SYSLOG
// syslog also has nginwho's own output, like the "Trapping ..." lines of the trap

local.file_match "system" {
	path_targets = [
		{
			__path__ = "/var/log/syslog",
			job      = "syslog",
		},
	]
}

loki.source.file "syslog" {
	targets    = local.file_match.system.targets
	forward_to = [loki.process.geoip.receiver]
}

local.file_match "nginx" {
	path_targets = [
		{
			__path__ = "/var/log/nginx/access.log",
			job      = "nginx",
		},
	]
}

loki.source.file "nginx" {
	targets    = local.file_match.nginx.targets
	forward_to = [loki.process.geoip.receiver]
}

// written by nginwho --serve, in the same format as the nginx one

local.file_match "nginwho" {
	path_targets = [
		{
			__path__ = "/var/log/nginwho/access.log",
			job      = "nginwho",
		},
	]
}

loki.source.file "nginwho" {
	targets    = local.file_match.nginwho.targets
	forward_to = [loki.process.geoip.receiver]
}

//

// GEOIP
// adds the country and network of each visitor and trapped IP, from https://ip66.dev (CC BY 4.0)
// the fields go in structured metadata, not labels, so they do not create new log streams

loki.process "geoip" {
	stage.match {
		selector = "{job=~\"nginx|nginwho\"}"

		stage.regex {
			expression = "^(?P<ip>\\S+) "
		}
	}

	stage.match {
		selector = "{job=\"syslog\"} |= \"Trapping \""

		stage.regex {
			expression = "Trapping (?P<ip>\\S+) "
		}
	}

	stage.geoip {
		db      = "/var/lib/alloy/ip66.mmdb"
		source  = "ip"
		db_type = "country"
	}

	stage.geoip {
		db      = "/var/lib/alloy/ip66.mmdb"
		source  = "ip"
		db_type = "asn"

		custom_lookups = {
			"hosting" = "traits.is_hosting_provider",
		}
	}

	stage.structured_metadata {
		values = {
			country      = "geoip_country_code",
			country_name = "geoip_country_name",
			network      = "geoip_autonomous_system_organization",
			hosting      = "",
		}
	}

	forward_to = [loki.write.default.receiver]
}

//

// nginwho database size
// nginwho 2.5.0 and up keep it in /var/lib/nginwho, older versions in /var/log/nginwho.db.
// the -wal file holds the newest writes until SQLite moves them into the database

otelcol.receiver.file_stats "default" {
	include = "/var/lib/nginwho/nginwho.db*"

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.exporter.prometheus.default.input]
	}
}

otelcol.exporter.prometheus "default" {
	// adds file_name to each metric, or the database and its -wal file would clash
	resource_to_telemetry_conversion = true
	forward_to = [prometheus.remote_write.default.receiver]
}

//

// Node Exporter
// the job name is what Grafana Cloud's "Linux Server" dashboards look for

discovery.relabel "metrics" {
	targets = prometheus.exporter.unix.metrics.targets

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

	rule {
		target_label = "job"
		replacement  = "integrations/node_exporter"
	}
}

prometheus.exporter.unix "metrics" {
	disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]

	filesystem {
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
		mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
		mount_timeout        = "5s"
	}

	netclass {
		ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15})$"
	}

	netdev {
		device_exclude = "^(veth.*|cali.*|[a-f0-9]{15})$"
	}
}

prometheus.scrape "metrics" {
	scrape_interval = "15s"
	targets         = discovery.relabel.metrics.output
	forward_to      = [prometheus.remote_write.default.receiver]
}

//
