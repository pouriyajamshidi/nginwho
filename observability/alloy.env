# Add these to /etc/default/alloy and fill them in. Grafana Cloud shows the values
# under your stack: "Loki" and "Prometheus" > Details, and Access Policies for a token
# that can write logs and metrics
GCLOUD_HOSTED_LOGS_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GCLOUD_HOSTED_LOGS_ID=000000
GCLOUD_HOSTED_METRICS_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GCLOUD_HOSTED_METRICS_ID=000000
GCLOUD_RW_API_KEY=glc_XXXX
