    {
      "type": "bargauge",
      "title": "Pressure now",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_cpu_waiting_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "CPU",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_memory_waiting_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "Memory",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_io_waiting_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "Disk",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_irq_stalled_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "Interrupts",
          "instant": true,
          "range": false
        }
      ],
      "description": "How much of the time programs had to wait for the CPU, memory, disk or interrupts. Close to 0% is good",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 120
      },
      "id": 40
    },
    {
      "type": "timeseries",
      "title": "Pressure over time",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_cpu_waiting_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "CPU"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_memory_waiting_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "Memory"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_io_waiting_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "Disk"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "avg(rate(node_pressure_irq_stalled_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "Interrupts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "How much of the time programs had to wait for the CPU, memory, disk or interrupts. Close to 0% is good",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 120
      },
      "id": 41
    },
    {
      "type": "timeseries",
      "title": "nginwho database size",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum({__name__=~\"file_size_b|file_size_bytes\", file_name=~\"nginwho.db.*\"})",
          "legendFormat": "database"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "description": "The database and its -wal file, where SQLite keeps the newest writes for a while",
