{
  "title": "nginwho",
  "uid": "nginwho",
  "tags": [
    "nginwho",
    "nginx"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "job",
        "label": "Access log",
        "type": "custom",
        "query": "nginx,nginwho",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": "nginx|nginwho",
        "multi": false,
        "options": []
      },
      {
        "name": "instance",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(up, instance)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "nginx",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "min(nginx_up{instance=~\"$instance\"})",
          "legendFormat": ""
        }
      ],
      "description": "Whether the nginx exporter can reach nginx. Needs the nginx exporter, see the README",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Requests",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Unique IPs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (ip) (count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Countries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (country) (count_over_time({job=~\"$job\"} | country != \"\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 5,
      "description": "Country data from ip66.dev (CC BY 4.0)"
    },
    {
      "type": "stat",
      "title": "5xx errors",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` | status =~ \"5..\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Data sent",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(sum_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` | unwrap bytes [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 7
    },
    {
      "type": "stat",
      "title": "Trap hits",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=\"syslog\"} |= \"nginwho\" |= \"Trapping \" | regexp `Trapping (?P<ip>\\S+) in the (?P<tactic>\\S+) for (?P<path>.*) \\((?P<trap>[^)]*)\\)$` [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 8
    },
    {
      "type": "stat",
      "title": "Database",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum({__name__=~\"file_size_b|file_size_bytes\", file_name=~\"nginwho.db.*\"})"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 9
    },
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (status) (count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 11,
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "Requests by method",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (method) (count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` [$__auto]))",
          "legendFormat": "{{method}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 12,
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "Data sent",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(sum_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` | unwrap bytes [$__auto]))",
          "legendFormat": "bytes"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 13,
      "interval": "1m"
    },
    {
      "type": "row",
      "title": "nginx",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Requests nginx answered",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(nginx_http_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Every request nginx answered, including the ones it handed to the trap, which the access log leaves out",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Connections by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(nginx_connections_active{instance=~\"$instance\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(nginx_connections_reading{instance=~\"$instance\"})",
          "legendFormat": "reading"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(nginx_connections_writing{instance=~\"$instance\"})",
          "legendFormat": "writing"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(nginx_connections_waiting{instance=~\"$instance\"})",
          "legendFormat": "waiting"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Connections accepted and handled",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(nginx_connections_accepted{instance=~\"$instance\"}[5m]))",
          "legendFormat": "accepted"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(nginx_connections_handled{instance=~\"$instance\"}[5m]))",
          "legendFormat": "handled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "description": "Handled stays with accepted unless nginx runs out of room for connections",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "id": 17
    },
    {
      "type": "state-timeline",
      "title": "nginx up",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "min(nginx_up{instance=~\"$instance\"})",
          "legendFormat": "nginx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "legend": {
          "showLegend": false
        },
        "mergeValues": true
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "id": 18
    },
    {
      "type": "row",
      "title": "Who and what",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "id": 19
    },
    {
      "type": "table",
      "title": "Top IPs",
      "description": "Country data from ip66.dev (CC BY 4.0)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(20, sum by (ip, country_name) (count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 39
      },
      "transformations": [
        {
          "id": "labelsToFields"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "ip": 0,
              "country_name": 1
            },
            "renameByName": {
              "Value": "hits",
              "Value #A": "hits",
              "country_name": "country"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "hits",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 20,
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hits"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Top paths",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(20, sum by (path) (count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 39
      },
      "transformations": [
        {
          "id": "labelsToFields"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "hits",
              "Value #A": "hits"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "hits",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 21,
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hits"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Top user agents",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(20, sum by (agent) (count_over_time({job=~\"$job\"} | pattern `<ip> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referrer>\" \"<agent>\"` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 39
      },
      "transformations": [
        {
          "id": "labelsToFields"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "hits",
              "Value #A": "hits"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "hits",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 22,
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hits"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
